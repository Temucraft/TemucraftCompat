<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Templates newer addons inherit. 3.3.5 frames support backdrops natively, so BackdropTemplate is empty. -->
	<Frame name="BackdropTemplate" virtual="true"/>
	<Font name="GameFontHighlightHuge" inherits="GameFontHighlightLarge" virtual="true">
		<FontHeight><AbsValue val="20"/></FontHeight>
	</Font>
	<Font name="GameFontNormalHuge2" inherits="GameFontNormalLarge" virtual="true">
		<FontHeight><AbsValue val="24"/></FontHeight>
	</Font>
	<ScrollFrame name="ScrollFrameTemplate" inherits="UIPanelScrollFrameTemplate" virtual="true"/>
	
	<EditBox name="SearchBoxTemplate" inherits="InputBoxTemplate" autoFocus="false" virtual="true">
		<Size><AbsDimension x="150" y="20"/></Size>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentSearchIcon" parentKey="searchIcon" file="Interface\Common\UI-Searchbox-Icon">
					<Size><AbsDimension x="14" y="14"/></Size>
					<Anchors><Anchor point="LEFT"><Offset><AbsDimension x="0" y="-2"/></Offset></Anchor></Anchors>
				</Texture>
				<FontString name="$parentInstructions" parentKey="Instructions" inherits="GameFontDisable" text="SEARCH" justifyH="LEFT">
					<Anchors><Anchor point="LEFT"><Offset><AbsDimension x="16" y="0"/></Offset></Anchor></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<TextInsets><AbsInset left="16" right="4" top="0" bottom="0"/></TextInsets>
		<Scripts>
			<OnEditFocusGained>self.Instructions:Hide()</OnEditFocusGained>
			<OnEditFocusLost>if self:GetText() == "" then self.Instructions:Show() end</OnEditFocusLost>
			<OnTextChanged>if self:GetText() ~= "" then self.Instructions:Hide() elseif not self:HasFocus() then self.Instructions:Show() end</OnTextChanged>
			<OnEscapePressed>self:SetText("") self:ClearFocus()</OnEscapePressed>
			<OnEnterPressed>self:ClearFocus()</OnEnterPressed>
		</Scripts>
	</EditBox>
	<EditBox name="BagSearchBoxTemplate" inherits="SearchBoxTemplate" virtual="true"/>
	<Button name="WowStyle1DropdownTemplate" virtual="true">
		<Size><AbsDimension x="150" y="26"/></Size>
		<Scripts><OnLoad>TemucraftCompat.InitDropdownButton(self)</OnLoad></Scripts>
	</Button>
	<Button name="WowStyle2DropdownTemplate" inherits="WowStyle1DropdownTemplate" virtual="true"/>
	<Frame name="WowScrollBoxList" virtual="true">
		<Scripts><OnLoad>TemucraftCompat.InitScrollBox(self)</OnLoad></Scripts>
	</Frame>
	<Frame name="WowScrollBox" inherits="WowScrollBoxList" virtual="true"/>
	<Slider name="MinimalScrollBarTemplate" inherits="UIPanelScrollBarTemplate" virtual="true">
		<Scripts><OnLoad>TemucraftCompat.InitScrollBar(self)</OnLoad></Scripts>
	</Slider>
	<Slider name="MinimalScrollBar" inherits="MinimalScrollBarTemplate" virtual="true"/>
	<Slider name="WowTrimScrollBar" inherits="MinimalScrollBarTemplate" virtual="true"/>
	<!-- Frames newer addons build on. Simple 3.3.5 versions with the members the addons read. -->
	<Frame name="DialogBorderOpaqueTemplate" virtual="true">
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
			<BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
			<TileSize><AbsValue val="32"/></TileSize>
			<EdgeSize><AbsValue val="32"/></EdgeSize>
		</Backdrop>
	</Frame>
	<Frame name="DialogBorderTemplate" inherits="DialogBorderOpaqueTemplate" virtual="true"/>
	<Frame name="ButtonFrameTemplate" inherits="DialogBorderOpaqueTemplate" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentTitleText" parentKey="TitleText" inherits="GameFontNormal">
					<Anchors><Anchor point="TOP"><Offset><AbsDimension x="0" y="-14"/></Offset></Anchor></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseButton" parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors><Anchor point="TOPRIGHT"><Offset><AbsDimension x="-4" y="-4"/></Offset></Anchor></Anchors>
			</Button>
		</Frames>
	</Frame>
	<Frame name="MicroButtonAlertTemplate" virtual="true" enableMouse="true">
		<Size><AbsDimension x="220" y="70"/></Size>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4"/></BackgroundInsets>
			<TileSize><AbsValue val="16"/></TileSize>
			<EdgeSize><AbsValue val="16"/></EdgeSize>
		</Backdrop>
		<Layers>
			<Layer level="OVERLAY">
				<FontString name="$parentText" parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT"><Offset><AbsDimension x="12" y="-12"/></Offset></Anchor>
						<Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-24" y="12"/></Offset></Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseButton" parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors><Anchor point="TOPRIGHT"><Offset><AbsDimension x="2" y="2"/></Offset></Anchor></Anchors>
			</Button>
		</Frames>
		<Scripts><OnLoad>self:SetBackdropColor(0, 0, 0, 0.9)</OnLoad></Scripts>
	</Frame>
	<Button name="MainHelpPlateButton" virtual="true">
		<Size><AbsDimension x="46" y="46"/></Size>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentI" parentKey="I" file="Interface\FriendsFrame\InformationIcon">
					<Size><AbsDimension x="46" y="46"/></Size>
					<Anchors><Anchor point="CENTER"/></Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentRing" parentKey="Ring" file="Interface\Minimap\MiniMap-TrackingBorder">
					<Size><AbsDimension x="64" y="64"/></Size>
					<Anchors><Anchor point="CENTER"><Offset><AbsDimension x="10" y="-10"/></Offset></Anchor></Anchors>
				</Texture>
			</Layer>
		</Layers>
		<HighlightTexture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD"/>
	</Button>
	<PlayerModel name="ModelWithControlsTemplate" virtual="true">
		<Scripts>
			<OnLoad>self.rotation = 0</OnLoad>
			<OnMouseWheel>Model_OnMouseWheel(self, delta)</OnMouseWheel>
		</Scripts>
	</PlayerModel>
	<!-- unit widgets (retail only): an empty container -->
	<Frame name="UIWidgetContainerTemplate" virtual="true">
		<Scripts><OnLoad>self.RegisterForWidgetSet = function() end self.UnregisterForWidgetSet = function() end self.ProcessAllWidgets = function() end</OnLoad></Scripts>
	</Frame>
	<Frame name="UIWidgetContainerNoResizeTemplate" inherits="UIWidgetContainerTemplate" virtual="true"/>
</Ui>
